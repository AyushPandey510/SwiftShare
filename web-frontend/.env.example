# Leave empty to auto-detect the API host.
# In development the app targets <current-host>:3001 automatically
# (so it works from localhost and from another device on the LAN).
#
# For production builds set the deployed API URL, for example:
# VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=https://swiftshare-e4dh.onrender.com
